{% extends 'base.html.twig' %}

{% block title %}Listagem de Livros{% endblock %}

{% block body %}

    {% include "_components/breadcrumb.html.twig" with { module: 'books', label: 'livro', child: null } %}

    {{ form(filterForm) }}

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col" class="text-end" style="width: 8%">#</th>
                    <th scope="col">Título</th>
                    <th scope="col">Editora</th>
                    <th scope="col" class="text-end">Ano de Publicação</th>
                    <th scope="col" class="text-end">Edição</th>
                    <th scope="col" class="text-end">Preço</th>
                    <th scope="col">Autores</th>
                    <th scope="col">Assuntos</th>
                    <th scope="col" style="width: 10%">
                        Ações
                        <a href="{{ path('books_new') }}" class="btn-solid btn-sm theme-primary">Novo</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for book in books %}
                    <tr>
                        <th scope="row" class="text-end">{{ book.id }}</th>
                        <td>{{ book.title }}</td>
                        <td>{{ book.publisher }}</td>
                        <td class="text-end">{{ book.published_year }}</td>
                        <td class="text-end">{{ book.edition }}</td>
                        <td class="text-end"><twig:MoneyBrl :value="book.price"></twig:MoneyBrl></td>
                        <td><twig:SeeMore :text="book.authors|map(a => a.name)|join(', ')"></twig:SeeMore></td>
                        <td><twig:SeeMore :text="book.subjects|map(s => s.description)|join(', ')"></twig:SeeMore></td>
                        <td>
                            {{ include('_components/action_buttons.html.twig', {pathName: 'books', id: book.id}) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                {% if books %}
                    <tr>
                        <td colspan="9">
                            {{ ux_pagination(books, theme: '@UXPagination/theme/bootstrap.html.twig') }}
                        </td>
                    </tr>
                {% endif %}
            </tfoot>
        </table>
    </div>

{% endblock %}
