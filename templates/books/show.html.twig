{% extends "base.html.twig" %}

{% block title  %}Livro #{{ book.id }}{% endblock %}

{% block body %}

    {% include "_components/breadcrumb.html.twig" with { module: 'books', label: 'livro', child: 'visualizar' } %}

    <p>
        <label>ID:</label>
        {{ book.id }}
    </p>

    <p>
        <label>Título:</label>
        {{ book.title }}
    </p>

    <p>
        <label>Editora:</label>
        {{ book.publisher }}
    </p>

    <p>
        <label>Ano de Publicação:</label>
        {{ book.published_year }}
    </p>

    <p>
        <label>Edição:</label>
        {{ book.edition }}
    </p>

    <p>
        <label>Preço (R$):</label>
        <twig:MoneyBrl :value="book.price"></twig:MoneyBrl>
    </p>

    <p>
        <label>ISBN:</label>
        {{ book.isbn }}
    </p>

    <p>
        <label>Autores:</label>
        {{ book.authors|map(a => a.name)|join(', ') }}
    </p>

    <p>
        <label>Assuntos:</label>
        {{ book.subjects|map(s => s.description)|join(', ') }}
    </p>

{% endblock %}
