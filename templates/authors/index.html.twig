{% extends 'base.html.twig' %}

{% block title %}Listagem de Autores{% endblock %}

{% block body %}

    {% include "_components/breadcrumb.html.twig" with { module: 'authors', label: 'autor', child: null } %}

    {{ form(filterForm) }}

    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Nome</th>
                <th scope="col">
                    Ações
                    <a href="{{ path('authors_new') }}" class="btn-solid btn-sm theme-primary">Novo</a>
                </th>
            </tr>
        </thead>
        <tbody>
            {% for author in authors %}
                <tr>
                    <th scope="row">{{ author.id }}</th>
                    <td>{{ author.name }}</td>
                    <td>
                        {{ include('_components/action_buttons.html.twig', {pathName: 'authors', id: author.id}) }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            {% if authors.count > 10 %}
                <tr>
                    <td colspan="3">
                        {{ ux_pagination(authors, theme: '@UXPagination/theme/bootstrap.html.twig') }}
                    </td>
                </tr>
            {% endif %}
        </tfoot>
    </table>

{% endblock %}
