{% extends 'base.html.twig' %}

{% block title %}Listagem de Assuntos{% endblock %}

{% block body %}

    {% include "_components/breadcrumb.html.twig" with { module: 'subjects', label: 'assunto', child: null } %}

    {{ form(filterForm) }}

    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Descrição</th>
                <th scope="col">
                    Ações
                    <a href="{{ path('subjects_new') }}" class="btn-solid btn-sm theme-primary">Novo</a>
                </th>
            </tr>
        </thead>
        <tbody>
            {% for subject in subjects %}
                <tr>
                    <th scope="row">{{ subject.id }}</th>
                    <td>{{ subject.description }}</td>
                    <td>
                        {{ include('_components/action_buttons.html.twig', {pathName: 'subjects', id: subject.id}) }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            {% if subjects %}
                <tr>
                    <td colspan="3">
                        {{ ux_pagination(subjects, theme: '@UXPagination/theme/bootstrap.html.twig') }}
                    </td>
                </tr>
            {% endif %}
        </tfoot>
    </table>

{% endblock %}
