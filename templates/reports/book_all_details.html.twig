{% extends 'base.html.twig' %}

{% block title %}Relatório completo de livros{% endblock %}

{% block body %}

    {% include "_components/breadcrumb.html.twig" with { module: null, label: 'relatório', child: 'livros todos os detalhes' } %}

    <div class="table-responsive">
        <table class="table">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Título</th>
                <th scope="col">Editora</th>
                <th scope="col">Ano de Publicação</th>
                <th scope="col">Edição</th>
                <th scope="col">Preço</th>
                <th scope="col">Autores</th>
                <th scope="col">Assuntos</th>
            </tr>
            {% for book in books %}
                <tr>
                    <td>{{ book.id }}</td>
                    <td>{{ book.title }}</td>
                    <td>{{ book.publisher }}</td>
                    <td>{{ book.published_year }}</td>
                    <td>{{ book.edition }}</td>
                    <td>R$ {{ book.price|number_format(2, ',', '.') }}</td>
                    <td>{{ book.authors }}</td>
                    <td>{{ book.subjects }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>

{% endblock %}
