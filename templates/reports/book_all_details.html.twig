{% extends 'base_print.html.twig' %}

{% block body %}

    {% include "_components/breadcrumb.html.twig" with { module: null, label: 'relatório', child: 'livros todos os detalhes' } %}

    <div class="table-responsive">
        <table class="table table-striped">
            <tr>
                <th scope="col" class="text-end">#</th>
                <th scope="col">Título</th>
                <th scope="col">Editora</th>
                <th scope="col" class="text-end">Ano de Publicação</th>
                <th scope="col" class="text-end">Edição</th>
                <th scope="col" class="text-end">Preço</th>
                <th scope="col">Autores</th>
                <th scope="col">Assuntos</th>
            </tr>
            {% for book in books %}
                <tr>
                    <td class="text-end">{{ book.id }}</td>
                    <td>{{ book.title }}</td>
                    <td>{{ book.publisher }}</td>
                    <td class="text-end">{{ book.published_year }}</td>
                    <td class="text-end">{{ book.edition }}</td>
                    <td class="text-end"><twig:MoneyBrl :value="book.price"></twig:MoneyBrl></td>
                    <td>{{ book.authors }}</td>
                    <td>{{ book.subjects }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>

{% endblock %}
