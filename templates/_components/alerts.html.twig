{% for message in app.flashes('error') %}
    <div class="alert theme-danger mb-3" role="alert">
        <p>{{ message }}</p>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

{% for message in app.flashes('warning') %}
    <div class="alert theme-warning mb-3" role="alert">
        <p>{{ message }}</p>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

{% for message in app.flashes('success') %}
    <div class="alert theme-success mb-3" role="alert">
        <p>{{ message }}</p>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}
