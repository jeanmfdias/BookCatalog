<nav aria-label="breadcrumb">
    <ol class="breadcrumb no-print">
        <li class="breadcrumb-item">
            <a class="breadcrumb-link" href="{{ path('home_index') }}">Home</a>
        </li>
        <li class="breadcrumb-divider"></li>
        <li class="breadcrumb-item">
            {% if module %}
                <a class="breadcrumb-link" href="{{ path(module ~ '_index') }}">{{ label|capitalize }}</a>
            {% else %}
                <a class="breadcrumb-link" href="#">{{ label|capitalize }}</a>
            {% endif %}
        </li>
        {% if child %}
            <li class="breadcrumb-divider"></li>
            <li class="breadcrumb-item" aria-current="page">
                <a class="breadcrumb-link active" href="#">{{ child|capitalize }}</a>
            </li>
        {% endif %}
    </ol>
</nav>
