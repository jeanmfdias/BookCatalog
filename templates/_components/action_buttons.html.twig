<form action="{{ path(pathName ~ '_delete', {id: id}) }}" method="POST" {{ stimulus_controller('swal') }}
    {{ stimulus_action('swal', 'confirm', 'submit') }}>
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ id) }}">
    <div class="btn-group" role="group" aria-label="btn-actions">
        <a href="{{ path(pathName ~ '_show', {id: id}) }}" class="btn-solid btn-sm theme-primary">Ver</a>
        <a href="{{ path(pathName ~ '_edit', {id: id}) }}" class="btn-solid btn-sm theme-warning">Editar</a>
        <button type="submit" class="btn-solid btn-sm theme-danger">Excluir</button>
    </div>
</form>
